APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myblog
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OPENAI_API_KEY=
OPENAI_MODEL_DRAFT=gpt-4o-mini
OPENAI_MODEL_PUBLISH=gpt-4o-mini
# Backward compatibility keys (optional)
OPENAI_MODEL=gpt-4o-mini
OPENAI_PUBLISH_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AI_BLOG_DEFAULT_LIMIT=5
AI_BLOG_PER_CATEGORY_LIMIT=2
AI_BLOG_MIN_DESCRIPTION_LENGTH=50
AI_BLOG_LONG_DESCRIPTION_LENGTH=220
AI_BLOG_FALLBACK_CATEGORY=news-updates
AI_BLOG_ALLOWED_KEYWORDS=ai,tech,travel,productivity,guide,tips,trends
AI_BLOG_BONUS_KEYWORDS=ai,2026
AI_BLOG_SCORE_TRENDS=3
AI_BLOG_SCORE_REDDIT=2
AI_BLOG_SCORE_RSS=1
AI_BLOG_SCORE_BONUS_KEYWORDS=2
AI_BLOG_SCORE_LONG_DESCRIPTION=1
AI_BLOG_SCHEDULE_TIME=06:00
AI_BLOG_LOG_CHANNEL=ai_blog
AI_BLOG_LOG_LEVEL=debug
AI_BLOG_LOG_DAYS=14
AI_BLOG_LOG_RESPONSE_BODY_LIMIT=1200
AI_BLOG_CACHE_TTL_MINUTES=20
AI_BLOG_MAX_DYNAMIC_CATEGORIES=4
AI_BLOG_MAX_CANDIDATES_MULTIPLIER=5
AI_BLOG_HIGH_ENGAGEMENT_THRESHOLD=100
AI_BLOG_SCORE_CATEGORY_KEYWORDS=2
AI_BLOG_SCORE_MULTI_SOURCE=3
AI_BLOG_SCORE_HIGH_ENGAGEMENT=1

AI_BLOG_TRENDS_ENABLED=true
AI_BLOG_TRENDS_URL=https://trends.google.com/trends/trendingsearches/daily/rss?geo=IN
AI_BLOG_TRENDS_CATEGORY=news-updates

AI_BLOG_REDDIT_ENABLED=true
AI_BLOG_REDDIT_USER_AGENT=myblog-bot/1.0 (+https://example.com)
AI_BLOG_REDDIT_SUBREDDITS=technology,travel,productivity
AI_BLOG_REDDIT_LIMIT_PER_SUBREDDIT=8

AI_BLOG_HN_ENABLED=true
AI_BLOG_GITHUB_ENABLED=true
AI_BLOG_DEVTO_ENABLED=true
AI_BLOG_MEDIUM_ENABLED=true
AI_BLOG_NEWSAPI_ENABLED=false
NEWSAPI_KEY=
AI_BLOG_STACKOVERFLOW_ENABLED=true
AI_BLOG_GDELT_ENABLED=true

AI_BLOG_TECH_FEED=https://news.google.com/rss/search?q=technology&hl=en-US&gl=US&ceid=US:en
AI_BLOG_TRAVEL_FEED=https://news.google.com/rss/search?q=travel&hl=en-US&gl=US&ceid=US:en
